{
  "name": "Phim3sApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8080",
    "ios": "react-native run-ios --simulator='iPhone 16'",
    "lint": "eslint .",
    "start": "react-native start --port 8080",
    "test": "jest",
    "pod": "cd ios && pod install",
    "create-screens": "node createFile.js screen ",
    "create-components": "node createFile.js component",
    "create-icon": "node createAsset.js icon",
    "android:dev": "adb reverse tcp:8080 tcp:8080 && react-native run-android --port 8080",
    "apk": "cd android && ./gradlew assembleRelease -PminifyEnabled=true -PshrinkResources=true",
    "aab": "cd android && ./gradlew bundleRelease",
    "postinstall": "patch-package",
    "clear_android": "cd android && ./gradlew clean && cd ..",
    "record": "xcrun simctl io booted recordVideo record.mov",
    "fonts": "npx react-native-asset",
    "install-apk": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "check-updates": "npx npm-check-updates -u && npm install"
  },
